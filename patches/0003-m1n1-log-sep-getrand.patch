 }
 
+static void sep_log_status(const char *phase, struct asc_mailbox_status status)
+{
+    printf("SEPDBG: %s A2I=%08x I2A=%08x\n", phase, status.a2i, status.i2a);
+}
+
 size_t sep_get_random(void *buffer, size_t len)
 {
     const struct asc_message msg_getrand = {.msg0 = FIELD_PREP(SEP_MSG_EP, SEP_EP_ROM) |
                                                     FIELD_PREP(SEP_MSG_CMD, SEP_MSG_GETRAND)};
     int ret;
     size_t done = 0;
+    const size_t requested = len;
 
     ret = sep_init();
-    if (ret)
+    if (ret) {
+        printf("SEPDBG: getrand aborted: init failed, requested=%zu\n", requested);
         return 0;
+    }
 
     while (len) {
         struct asc_message reply;
+        struct asc_mailbox_status before, sent, received;
+        bool send_ok, recv_ok = false;
         u32 rng;
         size_t copy;
 
-        if (!asc_send(sep_asc, &msg_getrand))
-            return done;
-        if (!asc_recv_timeout(sep_asc, &reply, SEP_TIMEOUT))
-            return done;
+        /* Sample control registers only; printing waits until the exchange ends. */
+        before = asc_get_mailbox_status(sep_asc);
+        send_ok = asc_send(sep_asc, &msg_getrand);
+        sent = asc_get_mailbox_status(sep_asc);
+        if (send_ok)
+            recv_ok = asc_recv_timeout(sep_asc, &reply, SEP_TIMEOUT);
+        received = asc_get_mailbox_status(sep_asc);
+
+        /* Report the first exchange and every failure, without printing RNG data. */
+        if (!done || !send_ok || !recv_ok ||
+            FIELD_GET(SEP_MSG_CMD, reply.msg0) != SEP_REPLY_GETRAND) {
+            printf("SEPDBG: getrand offset=%zu requested=%zu send=%s recv=%s timeout_us=%u\n",
+                   done, requested, send_ok ? "ok" : "failed",
+                   !send_ok ? "not-attempted" : (recv_ok ? "ok" : "timeout"), SEP_TIMEOUT);
+            sep_log_status("before-send", before);
+            sep_log_status("after-send", sent);
+            sep_log_status("after-recv", received);
+            if (recv_ok)
+                printf("SEPDBG: reply ep=0x%02lx type=0x%02lx\n",
+                       FIELD_GET(SEP_MSG_EP, reply.msg0), FIELD_GET(SEP_MSG_CMD, reply.msg0));
+        }
+
+        if (!send_ok || !recv_ok)
+            break;
         if (FIELD_GET(SEP_MSG_CMD, reply.msg0) != SEP_REPLY_GETRAND) {
-            printf("SEP: unexpected getrand reply: %016lx\n", reply.msg0);
-            return done;
+            printf("SEPDBG: unexpected reply type\n");
+            break;
         }
 
         rng = FIELD_GET(SEP_MSG_DATA, reply.msg0);
@@ -64,5 +99,6 @@ size_t sep_get_random(void *buffer, size_t len)
         buffer += copy;
     }
 
+    printf("SEPDBG: getrand complete=%zu/%zu\n", done, requested);
     return done;
 }
