diff --git a/src/sep.c b/src/sep.c
index 7a40fef..470abda 100644
--- a/src/sep.c
+++ b/src/sep.c
@@ -2,6 +2,8 @@
 
 #include <string.h>
 
+#include "../build/build_tag.h"
+
 #include "asc.h"
 #include "sep.h"
 #include "types.h"
@@ -16,42 +18,75 @@
 #define SEP_MSG_GETRAND   16
 #define SEP_REPLY_GETRAND 116
 
