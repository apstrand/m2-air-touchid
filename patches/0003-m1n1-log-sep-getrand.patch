+#define SEP_TIMEOUT 1000 /* microseconds, unchanged from upstream */
 
 static asc_dev_t *sep_asc = NULL;
 
 int sep_init(void)
 {
-    if (!sep_asc)
+    if (!sep_asc) {
+        printf("SEPDBG: build=%s init begin\n", BUILD_TAG);
         sep_asc = asc_init("/arm-io/sep");
+        printf("SEPDBG: init=%s\n", sep_asc ? "ok" : "failed");
+    }
     if (!sep_asc)
         return -1;
